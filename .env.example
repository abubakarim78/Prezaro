# ============================================================
# Prezaro — Production Environment Variables
# Configure these in Coolify / production container settings.
# ============================================================

# Application
NODE_ENV=production
PORT=3000

# Domain (e.g., attendance.yourdomain.com)
DOMAIN=

# Database (PostgreSQL)
# If using Coolify's 1-click PostgreSQL service, Coolify provides this automatically.
# Example: postgresql://prezaro:your_password@postgres:5432/prezaro?schema=public
DATABASE_URL=

# Authentication Secret
# Generate a strong 64-char key using: openssl rand -base64 32
AUTH_SECRET=

# First-time Admin Bootstrap (runs automatically on first launch)
BOOTSTRAP_EMAIL=abubakarima1969@uds.edu.gh
BOOTSTRAP_PASSWORD=ChangeThisToAStrongPassword2026!
BOOTSTRAP_NAME="Prezaro Administrator"
BOOTSTRAP_DEPARTMENT="General Administration"

# ============================================================
# Email Notifications (Resend - Recommended)
# Get a free API key at https://resend.com
# ============================================================
RESEND_API_KEY=
# Your verified sender domain (or 'Prezaro <onboarding@resend.dev>' for testing)
RESEND_FROM="Prezaro <attendance@yourdomain.com>"

# Optional Fallback: Traditional SMTP (e.g. Gmail / Brevo / SES)
# If neither Resend nor SMTP is configured, emails are safely logged in the in-app Outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
