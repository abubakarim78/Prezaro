// Prezaro — Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id                  String       @id @default(cuid())
  name                String
  code                String       // e.g. UDS, KNUST, CU
  slug                String       @unique // e.g. uds, knust, main
  logoUrl             String?
  primaryColor        String?      @default("#059669")
  contactEmail        String?
  contactPhone        String?
  plan                String       @default("TRIAL") // TRIAL | FACULTY | CAMPUS_ANNUAL | ENTERPRISE
  status              String       @default("ACTIVE") // ACTIVE | SUSPENDED | PENDING
  maxStudents         Int          @default(1000)
  maxCourses          Int          @default(100)
  allowedModes        String       @default("ALL") // ALL | WALKTHROUGH_ONLY | KIOSK_ONLY
  confidenceThreshold Float        @default(0.48) // 0.40 - 0.60
  lateGraceMinutes    Int          @default(15) // minutes after start
  termSystem          String       @default("SEMESTER") // SEMESTER | TRIMESTER | QUARTER
  atRiskThreshold     Int          @default(75) // % required attendance
  featuresJson        String       @default("{}") // Dynamic JSON flags: { allowOffline: true, requireConsent: true, notifyEmail: true, notifyPush: true }
  currentSemester     Int          @default(1) // 1..3 per termSystem — the current term driving enrollment course filtering
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  schools             School[]
  departments         Department[]
  users               User[]
}

model School {
  id            String       @id @default(cuid())
  name          String
  code          String
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  departments   Department[]
  users         User[]
  accessCodes   AccessCode[]
  submissions   EnrollmentSubmission[]

  @@unique([name, institutionId])
}

model Department {
  id            String       @id @default(cuid())
  name          String
  code          String
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  schoolId      String?
  school        School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  users         User[]
  courses       Course[]
  students      Student[]
  accessCodes   AccessCode[]
  submissions   EnrollmentSubmission[]

  @@unique([name, institutionId])
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  name          String
  title         String?
  role          String       @default("LECTURER") // LECTURER | ADMIN | DEAN | SUPERADMIN
  onboarded     Boolean      @default(false)
  settingsJson  String       @default("{}")
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  schoolId      String?
  school        School?      @relation(fields: [schoolId], references: [id])
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  taughtCourses Course[]     @relation("CourseLecturer")
  sessions      Session[]    @relation("SessionLecturer")
  schedules     ClassSchedule[]
  codesCreated  AccessCode[] @relation("CodesCreated")
  codeClaimedId String?
  codeClaimed   AccessCode?  @relation("CodesClaimed", fields: [codeClaimedId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
}

model Course {
  id           String       @id @default(cuid())
  code         String
  title        String
  level        Int          @default(200)
  semester     Int          @default(1) // 1..3 (trimester systems use 3)
  termSystem   String       @default("SEMESTER") // SEMESTER | TRIMESTER
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id])
  lecturerId   String
  lecturer     User         @relation("CourseLecturer", fields: [lecturerId], references: [id])
  enrollments  Enrollment[]
  sessions     Session[]
  schedules    ClassSchedule[]
  createdAt    DateTime     @default(now())

  @@unique([code, departmentId])
}

model Student {
  id              String             @id @default(cuid())
  studentId       String             @unique
  firstName       String
  lastName        String
  level           Int
  email           String?
  phone           String?
  departmentId    String?
  department      Department?        @relation(fields: [departmentId], references: [id])
  descriptorsJson String             @default("[]") // JSON array of 128-d face descriptors
  photoData       String?            // enrollment reference photo (JPEG data URL)
  faceEnrolledAt  DateTime?
  consentVersion  String?
  enrollments     Enrollment[]
  records         AttendanceRecord[]
  createdAt       DateTime           @default(now())
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
}

model Session {
  id         String             @id @default(cuid())
  courseId   String
  course     Course             @relation(fields: [courseId], references: [id])
  lecturerId String
  lecturer   User               @relation("SessionLecturer", fields: [lecturerId], references: [id])
  mode       String             @default("WALKTHROUGH") // WALKTHROUGH | KIOSK | MANUAL
  status     String             @default("OPEN") // OPEN | COMPLETED | CANCELLED
  startedAt  DateTime           @default(now())
  endedAt    DateTime?
  records    AttendanceRecord[]
}

model AttendanceRecord {
  id            String   @id @default(cuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  status        String   @default("PRESENT") // PRESENT | LATE | ABSENT
  method        String   @default("FACE") // FACE | MANUAL | ONLINE
  justification String?  // CONSENT_OPT_OUT | MEDICAL_EXCUSE | CAMERA_ISSUE | LATE_PERMISSION | OFFICIAL_DUTY | OTHER
  note          String?  // Lecturer comments
  confidence    Float?
  markedAt      DateTime @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model AccessCode {
  id              String       @id @default(cuid())
  code            String       @unique // e.g. CS-LEC-9281
  role            String       @default("LECTURER") // LECTURER | ADMIN | DEAN
  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  schoolId        String?
  school          School?      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  maxUses         Int          @default(1)
  usedCount       Int          @default(0)
  status          String       @default("ACTIVE") // ACTIVE | EXHAUSTED | REVOKED | EXPIRED
  expiresAt       DateTime?
  designatedEmail String?
  designatedName  String?
  createdById     String
  createdBy       User         @relation("CodesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  claimedUsers    User[]       @relation("CodesClaimed")
  createdAt       DateTime     @default(now())

  @@index([departmentId, status])
}

model EnrollmentSubmission {
  id              String      @id @default(cuid())
  studentId       String      // Index number
  firstName       String
  lastName        String
  email           String
  phone           String?
  level           Int         @default(100)
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  schoolId        String?
  school          School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseIdsJson   String      @default("[]") // JSON string array of course codes/IDs
  descriptorsJson String      @default("[]")
  photoData       String?
  consentGiven    Boolean     @default(true)
  status          String      @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason String?
  createdAt       DateTime    @default(now())
  reviewedAt      DateTime?

  @@index([departmentId, status])
  @@index([schoolId, status])
}

// Outbox log of every notification email the system produces.
// When SMTP env vars are absent, emails are stored as SIMULATED
// (visible in Settings → Email notifications) instead of delivered.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  bodyHtml  String
  type      String   // WELCOME | ACCOUNT_ALERT | STUDENT_REGISTERED | COURSE_ENROLLMENT | TEST
  status    String   @default("SIMULATED") // SENT | SIMULATED | FAILED
  error     String?
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ClassSchedule {
  id                  String   @id @default(cuid())
  courseId            String
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturerId          String
  lecturer            User     @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  dayOfWeek           Int      // 1 = Monday, 2 = Tuesday, ..., 7 = Sunday
  startTime           String   // "08:00" (24h HH:mm)
  endTime             String   // "10:00" (24h HH:mm)
  venue               String?  // e.g. "Lecture Theatre 1", "Room 402"
  recurrence          String   @default("WEEKLY") // WEEKLY | BIWEEKLY | ONCE
  reminderLeadMinutes Int      @default(30) // 15 | 30 | 60
  notifyEmail         Boolean  @default(true)
  notifyPush          Boolean  @default(true)
  lastNotifiedDate    String?  // YYYY-MM-DD for deduplication
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([lecturerId, dayOfWeek])
}
